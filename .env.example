# Gemini API free tier. Create this key in Google AI Studio.
GEMINI_API_KEY=
# Free-tier availability and rate limits can vary by account/region.
GEMINI_MODEL=gemini-3.1-flash-lite

# Created by `caspian init`
CASPIAN_API_KEY=
CASPIAN_BASE_URL=

# Connection ID emitted by `caspian connect email`.
# Email is used for real volunteer escalation.
EMAIL_CONNECTION_ID=
VOLUNTEER_EMAIL=

# Optional: use this only if you connect WhatsApp for the farmer-facing demo.
WHATSAPP_CONNECTION_ID=

# Set to true only during a supervised demo. In normal operation the agent
# asks permission before sharing the user's message with a volunteer.
DEMO_AUTO_ESCALATE=false
